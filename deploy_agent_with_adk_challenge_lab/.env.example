# Configuración de Google Cloud y Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=tu_id_de_proyecto_gcp
GOOGLE_CLOUD_LOCATION=us-central1
RESOURCES_BUCKET=tu_bucket_de_recursos
MODEL=gemini-2.5-flash
SEARCH_ENGINE_ID=tu_search_engine_id_de_agent_search

# Configuración de Agent Runtime (Reasoning Engine desplegado)
AGENT_RESOURCE_NAME=projects/tu_project_id/locations/us-central1/reasoningEngines/tu_engine_id
